# Database & Storage
POSTGRES_USER=pesaguard
POSTGRES_DB=pesaguard
POSTGRES_PASSWORD=replace-with-local-only-password
DATABASE_URL_DOCKER=postgresql://pesaguard:replace-with-local-only-password@postgres:5432/pesaguard
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
# Use an independent random key in staging/production; retain the previous key during rotations.
PESAGUARD_PAYLOAD_ENCRYPTION_KEY=replace-with-independent-random-encryption-key
REDIS_URL=redis://localhost:6379/0

REDIS_URL_DOCKER=redis://redis:6379/0
PESAGUARD_API_URL=https://api.pesaguard.co.ke
# Retain both origins when overriding the API's default CORS allowlist.
PESAGUARD_CORS_ALLOWED_ORIGINS=https://api.pesaguard.co.ke,https://app.pesaguard.co.ke,https://status.pesaguard.co.ke
# Use a random value of at least 32 characters; also configure it as the
# PESAGUARD_STATUS_MONITOR_TOKEN GitHub Actions secret. Never commit the value.
# Optional imported registry dataset lookup; server-side only. Local HTTP is development-only.
PESAGUARD_DATASOURCE_BASE_URL=
PESAGUARD_DATASOURCE_API_KEY=
PESAGUARD_DATASOURCE_CONNECT_TIMEOUT_SECONDS=2
PESAGUARD_DATASOURCE_READ_TIMEOUT_SECONDS=5

PESAGUARD_STATUS_MONITOR_TOKEN=
# Generate a high-entropy secret; Compose mounts it for Alertmanager's Authorization: Bearer credentials_file and passes it to the receiver.
PESAGUARD_ALERTMANAGER_WEBHOOK_SECRET=
PESAGUARD_EVENT_STATE_REDIS_URL=redis://localhost:6379/1
PESAGUARD_EVENT_STATE_PREFIX=pesaguard:event-delivery
PESAGUARD_API_AUTH_REQUIRED=1
PESAGUARD_BIND_HOST=127.0.0.1

PESAGUARD_BIND_HOST_DOCKER=0.0.0.0

# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

KAFKA_BOOTSTRAP_SERVERS_DOCKER=redpanda:9092
KAFKA_BOOTSTRAP_SERVERS_FULL=kafka:9092
KAFKA_ADVERTISED_LISTENERS_FULL=PLAINTEXT://kafka:9092
STAGING_POSTGRES_DB=pesaguard_staging
STAGING_KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka-staging:9092
POSTGRES_ARCHIVE_COMMAND=test ! -f /var/lib/postgresql/wal_archive/%f && cp %p /var/lib/postgresql/wal_archive/%f
KAFKA_TOPIC_TRANSACTIONS=mpesa.transactions.raw
KAFKA_TOPIC_MATCHED=mpesa.transactions.matched
KAFKA_TOPIC_DISCREPANCIES=mpesa.discrepancies

# Tenant & Connector Settings
TENANT_ID=default
CONNECTOR_TYPE=postgres
INTERNAL_RECORDS_TABLE=orders
CONNECTOR_MAPPING_FILE=
CONNECTOR_REST_ENDPOINT=
CONNECTOR_AUTH_TYPE=api_key
CONNECTOR_AUTH_VALUE=

# Notification Channels
SLACK_WEBHOOK_URL=
# SMTP email: supply provider credentials only in the ignored deployment file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PesaGuard
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Reconciliation Parameters
RECONCILIATION_WINDOW_MINUTES=15
RQ_QUEUE_NAME=transaction_events

# Safaricom Daraja API Credentials (Sandbox / Production)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here
DARAJA_SHARED_SECRET=

# Encrypted off-site backup requirements for production
PESAGUARD_ENVIRONMENT=development
PESAGUARD_BACKUP_ENCRYPT_COMMAND=
PESAGUARD_BACKUP_UPLOAD_COMMAND=

# Africa's Talking communications (use sandbox credentials outside production)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SHORTCODE=
AFRICASTALKING_CALLBACK_BASE_URL=
AFRICASTALKING_WEBHOOK_SECRET=
AFRICASTALKING_TIMEOUT_SECONDS=10
AFRICASTALKING_MAX_RETRIES=5
PESAGUARD_COMMUNICATION_RETRY_BASE_SECONDS=5
PESAGUARD_COMMUNICATION_RETRY_MAX_SECONDS=600
PESAGUARD_COMMUNICATION_RETRY_JITTER=0.25

# OpenTelemetry distributed tracing
# Leave endpoint blank to run with local structured trace fallback only.
# For Docker Compose, use OTEL_EXPORTER_OTLP_ENDPOINT=http://otel_collector:4317.
# For a hosted collector, set its private HTTPS/gRPC OTLP endpoint in deployment secrets.
OTEL_SERVICE_NAME=pesaguard-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10
OTEL_EXPORTER_OTLP_TIMEOUT=5
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health,/livez,/metrics

# Optional Sentry error reporting
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
