# PesaGuard Staging Environment Configuration (.env.staging)
# Current Date Anchor: July 2026

# Database & Redis (Staging Isolated Instances)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DATABASE
REDIS_URL=redis://localhost:6380/0
PESAGUARD_API_URL=https://api.pesaguard.co.ke

# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
POSTGRES_ARCHIVE_COMMAND=test ! -f /var/lib/postgresql/wal_archive/%f && cp %p /var/lib/postgresql/wal_archive/%f
KAFKA_TOPIC_TRANSACTIONS=mpesa.transactions.raw.staging
KAFKA_TOPIC_MATCHED=mpesa.transactions.matched.staging
KAFKA_TOPIC_DISCREPANCIES=mpesa.discrepancies.staging

# Tenant & Connector Settings
TENANT_ID=staging-tenant
CONNECTOR_TYPE=postgres
INTERNAL_RECORDS_TABLE=orders_staging
CONNECTOR_MAPPING_FILE=
CONNECTOR_REST_ENDPOINT=
CONNECTOR_AUTH_TYPE=api_key
CONNECTOR_AUTH_VALUE=

# Notification Channels (Staging Alert Webhook)
SLACK_WEBHOOK_URL=

# Reconciliation Parameters
RECONCILIATION_WINDOW_MINUTES=15
RQ_QUEUE_NAME=transaction_events_staging

# Safaricom Daraja API Credentials (Supports both standard spelling and legacy fallback)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=replace-me
DARJA_CONSUMER_SECRET=replace-me
DARJA_CONSUMER_KEY=replace-me
DARJA_CONSUMER_SECRET=replace-me
