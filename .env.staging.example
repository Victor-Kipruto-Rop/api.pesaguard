# Local/staging-only Compose template. Replace credential placeholders before use.
# Never copy these placeholder credentials into a production deployment.
PESAGUARD_ENVIRONMENT=staging
PESAGUARD_API_AUTH_REQUIRED=1
JWT_SECRET_KEY=replace-with-at-least-32-random-staging-bytes
PESAGUARD_PAYLOAD_ENCRYPTION_KEY=replace-with-a-generated-staging-Fernet-key
PESAGUARD_PAYLOAD_ENCRYPTION_KEY_PREVIOUS=
POSTGRES_USER=pesaguard_staging
POSTGRES_PASSWORD=replace-with-staging-only-password
STAGING_POSTGRES_DB=pesaguard_staging
DATABASE_URL=postgresql://pesaguard_staging:replace-with-staging-only-password@postgres-staging:5432/pesaguard_staging
REDIS_URL=redis://redis-staging:6379/0
PESAGUARD_API_URL=https://api.staging.pesaguard.co.ke
DEPLOYMENT_REGION=ke-1
BACKUP_REGION=ke-1
LOG_REGION=ke-1
KAFKA_BOOTSTRAP_SERVERS=kafka-staging:9092
STAGING_KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka-staging:9092
POSTGRES_ARCHIVE_COMMAND=test ! -f /var/lib/postgresql/wal_archive/%f && cp %p /var/lib/postgresql/wal_archive/%f
KAFKA_TOPIC_TRANSACTIONS=mpesa.transactions.raw
KAFKA_TOPIC_MATCHED=mpesa.transactions.matched
KAFKA_TOPIC_DISCREPANCIES=mpesa.discrepancies
TENANT_ID=staging
CONNECTOR_TYPE=postgres
INTERNAL_RECORDS_TABLE=orders
CONNECTOR_MAPPING_FILE=
CONNECTOR_REST_ENDPOINT=
CONNECTOR_AUTH_TYPE=api_key
CONNECTOR_AUTH_VALUE=
SLACK_WEBHOOK_URL=
RECONCILIATION_WINDOW_MINUTES=15
RQ_QUEUE_NAME=transaction_events
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=replace-with-staging-sandbox-key
DARAJA_CONSUMER_SECRET=replace-with-staging-sandbox-secret
